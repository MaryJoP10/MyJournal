<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MyJournal"
             x:Class="MyJournal.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Paleta principal (tema claro por defecto) -->
            <Color x:Key="PrimaryColor">#E63946</Color>
            <Color x:Key="PrimaryVariant">#6A3D9A</Color>
            <Color x:Key="AccentColor">#F7E7A3</Color>
            <Color x:Key="BackgroundColor">#F8F1E7</Color>
            <Color x:Key="SurfaceColor">#FFF8EF</Color>
            <Color x:Key="TextColor">#2A2030</Color>

            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{DynamicResource BackgroundColor}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
