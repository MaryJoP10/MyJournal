@page "/"
@using MyJournal.Core.Entities
@inject MyJournal.Services.Services.IHabitService HabitService
@inject MyJournal.Services.Services.ITaskService TaskService
@inject MyJournal.Services.Services.IJournalService JournalService

<div class="container py-3">
    <h2>@greeting</h2>
    <p class="text-muted">@todayString</p>

    <div class="row">
        <div class="col-12 col-md-4 mb-3">
            <div class="card p-3">
                <h5>Hábitos</h5>
                <p>@habitsCount hábitos activos</p>
            </div>
        </div>
        <div class="col-12 col-md-4 mb-3">
            <div class="card p-3">
                <h5>Tareas</h5>
                <p>@tasksCount tareas</p>
            </div>
        </div>
        <div class="col-12 col-md-4 mb-3">
            <div class="card p-3">
                <h5>Journal</h5>
                <p>@journalCount entradas</p>
                <NavLink class="btn btn-sm btn-primary" href="journal">Abrir Journal</NavLink>
            </div>
        </div>
    </div>

</div>

@code {
    private string greeting = "Hola";
    private string todayString = string.Empty;
    private int habitsCount = 0;
    private int tasksCount = 0;
    private int journalCount = 0;

    protected override async Task OnInitializedAsync()
    {
        var now = DateTime.Now;
        todayString = now.ToString("dddd, d MMMM yyyy");
        greeting = now.Hour < 12 ? "Buenos días" : now.Hour < 18 ? "Buenas tardes" : "Buenas noches";

        var habits = await HabitService.GetAllAsync();
        habitsCount = habits?.Count() ?? 0;

        var tasks = await TaskService.GetAllAsync();
        tasksCount = tasks?.Count() ?? 0;

        var journals = await JournalService.GetAllAsync();
        journalCount = journals?.Count() ?? 0;
    }
}
