@page "/"
@using MyJournal.Core.Entities
@using MyJournal.Components.Dashboard
@inject MyJournal.Services.Services.IHabitService HabitService
@inject MyJournal.Services.Services.ITaskService TaskService
@inject MyJournal.Services.Services.IJournalService JournalService

<div class="dashboard-root">
    <DashboardHeader />

    <section class="dashboard-main">
        <div class="main-left">
            <article class="overview">
                <DailyProgressCard />
            </article>

            <div class="lower-grid">
                <section class="tasks">
                    <TodayTasksCard />
                </section>
                <section class="habits">
                    <HabitsSummaryCard />
                </section>
                <section class="routine">
                    <RoutineSummaryCard />
                </section>
            </div>
        </div>

        <aside class="main-right">
            <JournalPreviewCard />
            <GoalsSummaryCard />
            <QuestSummaryCard />
            <QuickActionsCard />
        </aside>
    </section>
</div>

@code {
    // El contenido y la lógica de presentación está distribuida en componentes individuales.
}
